{
  "name": "music-share",
  "version": "0.0.1",
  "description": "share your music the way you want it",
  "homepage": "https://github.com/egnrse/music-sharing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egnrse/music-sharing.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "Elia Nitsche",
  "scripts": {
    "prestart": "pnpm run build",
    "start": "node backend/dist/server.js",
    "dev": "tsx --watch backend/server.ts",
    "devF": "tsc --watch -p ./public",
    "build:front": "tsc -p ./public",
    "build:back": "tsc -p ./backend",
    "build": "pnpm run build:front && pnpm run build:back",
    "test:front": "tsc --noEmit -p ./public/",
    "test:back": "tsc --noEmit -p ./backend/",
    "test:css": "stylelint ./public/**/*.css --config .stylelintrc.json",
    "test:html": "htmlhint ./public/**/*.html --config .htmlhintrc --ignore \"node_modules/**\"",
    "test": "pnpm run test:front && pnpm run test:back && pnpm run test:css && pnpm run test:html",
    "cli": "pnpm tsx ./backend/cli.ts",
    "clean": "rm -rf ./backend/dist/* ./public/dist/*"
  },
  "type": "module",
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "enquirer": "^2.4.1",
    "express": "^5.2.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "htmlhint": "^1.9.2",
    "stylelint": "^17.11.1",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.21.0"
  },
  "optionalDependencies": {
    "music-metadata": "^11.12.3"
  }
}
